# CourseHub backend environment
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Flask ---
# Random string used to sign Flask sessions. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# "True" enables Flask debug mode (local dev only)
DEBUG=True
# Used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000

# --- MongoDB Atlas ---
# Include the database name in the path; the app calls get_default_database()
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Supabase ---
# Dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# SERVER-SIDE ONLY: service_role key (used for /auth/v1/admin/* calls).
# Dashboard > Project Settings > API Keys > "Legacy API keys" tab > service_role
SUPABASE_KEY=your-supabase-service-role-key
# Dashboard > Project Settings > JWT Keys > "Legacy JWT secret"
# The backend verifies user tokens with HS256 using this secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- AWS (SES, for verification and password-reset emails) ---
# IAM user scoped to ses:SendEmail / ses:SendRawEmail only
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Must be a verified SES identity (address or domain) in AWS_REGION
EMAIL_FROM=no-reply@yourdomain.com
