# CourseHub frontend environment (Create React App)
# Copy to frontend/.env and fill in real values. Never commit frontend/.env.
# Everything here is bundled into the browser, so only put PUBLIC values here.
# Restart `npm start` after changing this file.

# Flask backend base URL
REACT_APP_API_URL=http://127.0.0.1:5000

# Supabase: Dashboard > Project Settings > API Keys
REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
# The PUBLIC anon key. Never put the service_role key here.
REACT_APP_SUPABASE_KEY=your-supabase-anon-key

# College Scorecard API (school search in profile setup)
# Free key: https://api.data.gov/signup/
REACT_APP_COLLEGE_SCORECARD_API_KEY=your-api-data-gov-key
